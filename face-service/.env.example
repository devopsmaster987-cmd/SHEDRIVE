# Copy to .env for local development. Never commit real secrets.
# Confidence needed to auto-approve a female prediction (0-1).
CONF_THRESHOLD=0.85

# Maximum accepted selfie size in megabytes.
MAX_UPLOAD_MB=5

# DeepFace embedding model. Facenet512 is available on the ONNX backend.
FACE_MODEL=Facenet512

# DeepFace runtime backend: onnx (default, lightweight), tensorflow or pytorch.
DEEPFACE_BACKEND_ENGINE=onnx

# Face detector and preload behaviour.
DETECTOR_BACKEND=opencv
PRELOAD_MODELS=true

# Reject decompression bombs before allocating huge pixel buffers.
MAX_IMAGE_PIXELS=25000000

# Limit concurrent CPU-heavy verifications.
MAX_CONCURRENT_VERIFICATIONS=1

# Single forward pass timeout in seconds.
VERIFY_TIMEOUT_SECONDS=20

# Optional: info, warning, error.
LOG_LEVEL=info
