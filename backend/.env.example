# Copy to .env and fill in local values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB container, or a MongoDB Atlas connection string in production
MONGODB_URI=mongodb://localhost:27017/shedrive

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Auth (required)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Face verification microservice
FACE_SERVICE_URL=http://localhost:8000
FACE_CONFIDENCE_THRESHOLD=0.85
FACE_TIMEOUT_MS=20000

# Optional: share Socket.IO rooms across multiple backend replicas.
# Leave blank for a single-process local server.
REDIS_URL=

# OTP provider: mock (logs OTP in dev) or twilio / fast2sms (stubs)
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Private local storage for driver licence documents
STORAGE_DIR=./storage

# Fare estimate (INR): base + per-km rate, with a minimum fare
FARE_BASE=40
FARE_PER_KM=14
FARE_ROAD_FACTOR=1.25
FARE_MINIMUM=50

# Live ride matching
RIDE_SEARCH_RADIUS_KM=5
RIDE_OFFER_TTL_SECONDS=45
RIDE_REQUEST_TTL_MINUTES=10

# Optional providers (not needed for local demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional seed overrides (npm run seed)
ADMIN_EMAIL=admin@shedrive.test
ADMIN_PHONE=+910000000001
ADMIN_PASSWORD=Admin@12345
DEMO_RIDER_EMAIL=rider@shedrive.test
DEMO_RIDER_PHONE=+910000000003
DEMO_RIDER_PASSWORD=Rider@12345
DEMO_DRIVER_EMAIL=driver@shedrive.test
DEMO_DRIVER_PHONE=+910000000004
DEMO_DRIVER_PASSWORD=Driver@12345
