{
  "name": "shedrive-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SheDrive REST API and realtime server",
  "main": "src/server.js",
  "scripts": {
    "start": "node --require ./dns-fix.cjs src/server.js",
    "dev": "node --require ./dns-fix.cjs --watch src/server.js",
    "test": "jest --runInBand",
    "lint": "node scripts/lint.js",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "node src/scripts/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.0.2",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
